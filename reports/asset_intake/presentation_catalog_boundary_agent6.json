      "gap_id": "audio_registry_is_silent_router",
      "detail": "data/audio/audio_event_map.json currently contains mode/category only and legacy underscore IDs. It has no stable asset_key or playback resource."
    },
    {
      "gap_id": "credits_surface_absent",
      "detail": "No existing Credits, Third-Party Assets, Licenses, Music, or Fonts player-facing surface was found in MenuRootLobby or MenuOverlay."
    },
    {
      "gap_id": "production_dock_has_no_drag_layout",
      "detail": "Production PlayerCardDock uses three HBox pools and one Action Spine route. The legacy HandRack has drag behavior but is intentionally retired from production and must not be reattached."
    },
    {
      "gap_id": "planet_backdrop_is_translucent_and_ringed",
      "detail": "PlanetGlobeBackdrop draws the ocean with alpha below 1, draws a table ring, and PlanetMapView instantiates PlanetOrbitGuide. Those are the exact presentation nodes to replace/remove for opacity and OUTER_ORBIT_DECORATION_COUNT=0."
    },
    {
      "gap_id": "backside_markers_are_not_3d_occluded",
      "detail": "The current sceneized map is a 2D Control layer stack. A presentation proxy must cull backside facilities, markers, and models against camera-facing hemisphere without changing authoritative region/entity data."
    }
  ],
