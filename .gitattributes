# Keep repository text byte-stable across Windows clones. Binary assets remain
# binary through text=auto; scripts, scenes, Resources, docs, and sidecars use LF.
* text=auto eol=lf

# Godot rewrites import sidecars with LF, so make the policy explicit.
*.import text eol=lf

# V076 correction evidence is hash-sealed from exact Windows-produced bytes.
# Do not normalize JSON, Markdown, or SHA sidecars in this append-only tree.
reports/reuse/correction_v2/** binary

# Full-convergence raw scans are also sealed from exact scanner output bytes.
# Preserve CRLF where emitted so the declared SHA-256 and Git blob identity bind
# the same byte sequence before and after the evidence is committed.
reports/reuse/full_convergence/raw_scans/** binary

# Generation 10 reuses the exact Windows Compatibility manifest bytes.
reports/reuse/full_convergence/generation10/canonical_import_terminal_repair_002/pass-001/imported_manifest.json binary
reports/reuse/full_convergence/generation10/canonical_import_terminal_repair_002/pass-002/imported_manifest.json binary

