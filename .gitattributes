# Keep repository text byte-stable across Windows clones. Binary assets remain
# binary through text=auto; scripts, scenes, Resources, docs, and sidecars use LF.
* text=auto eol=lf

# Godot rewrites import sidecars with LF, so make the policy explicit.
*.import text eol=lf

# Preserve upstream Kenney license evidence byte-for-byte; these files contain
# intentional leading tabs and CRLF line endings from the selected archives.
assets/third_party/commercial/audio/kenney_interface_sounds/LICENSE.txt binary
assets/third_party/commercial/audio/kenney_scifi_sounds/LICENSE.txt binary
