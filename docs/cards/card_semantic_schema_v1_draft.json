        {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability_id", "ordinary_hand_limit"],
          "properties": {
            "capability_id": { "const": "hand_capacity" },
            "ordinary_hand_limit": { "type": "integer", "minimum": 5, "maximum": 9 }
          }
