  "$defs": {
    "StableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "Fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "NonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "SignedSafeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "IndustryId": {
      "enum": ["commerce", "energy", "industry", "life", "shipping", "technology"]
    },
    "IndustryOrNeutralId": {
      "enum": ["commerce", "energy", "industry", "life", "neutral", "shipping", "technology"]
    },
    "CardCategoryId": {
      "enum": ["commodity", "facility", "interaction", "military", "monster", "organization", "supply_demand"]
    },
    "ColoredAssetVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commerce", "energy", "industry", "life", "shipping", "technology"],
      "properties": {
        "commerce": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "energy": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "industry": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "life": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "shipping": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "technology": { "$ref": "#/$defs/NonNegativeSafeInteger" }
      }
    },
    "CardIdentitySpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "family_id", "rank", "category_id", "ruleset_id", "definition_revision", "tag_ids"],
      "properties": {
        "card_id": { "$ref": "#/$defs/StableId" },
        "family_id": { "$ref": "#/$defs/StableId" },
        "rank": { "type": "integer", "minimum": 1, "maximum": 4 },
        "category_id": { "$ref": "#/$defs/CardCategoryId" },
        "industry_id": { "$ref": "#/$defs/IndustryId" },
        "ruleset_id": { "const": "space_syndicate_v06" },
        "definition_revision": { "$ref": "#/$defs/PositiveSafeInteger" },
        "tag_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/StableId" }
        },
        "unique_scope_id": { "enum": ["none", "global_same_family"] }
      },
      "allOf": [
        {
          "if": { "properties": { "category_id": { "const": "commodity" } }, "required": ["category_id"] },
          "then": { "required": ["industry_id"] }
        }
      ]
    },
    "CardCostSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_kind_id",
        "purchase_cash_cents",
        "play_cost_kind_id",
        "colored_asset_cost_units",
        "generic_asset_cost_units",
        "submission_kind_id",
        "card_disposition_id",
        "transaction_policy_id"
      ],
      "properties": {
        "acquisition_kind_id": { "enum": ["commodity_belt_free", "not_acquirable", "region_rack_cash"] },
        "purchase_cash_cents": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "play_cost_kind_id": { "enum": ["assets", "free"] },
        "colored_asset_cost_units": { "$ref": "#/$defs/ColoredAssetVector" },
        "generic_asset_cost_units": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "submission_kind_id": { "enum": ["counter_response", "ordinary"] },
        "card_disposition_id": { "enum": ["consume_on_commit", "install_on_success"] },
        "transaction_policy_id": { "const": "prepare_commit_rollback_exact_once" }
      }
    },
    "CardTimingSpec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["timing_id", "submission_phase_id", "cadence_profile_id", "clock_id"],
          "properties": {
            "timing_id": { "const": "shared_card_window" },
            "submission_phase_id": { "const": "planning" },
            "cadence_profile_id": { "const": "shared_card_window_v06" },
            "clock_id": { "const": "world_effective" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["timing_id", "submission_phase_id", "cadence_profile_id", "clock_id"],
          "properties": {
            "timing_id": { "const": "counter_response_window" },
            "submission_phase_id": { "const": "response" },
            "cadence_profile_id": { "const": "single_counter_layer_v06" },
            "clock_id": { "const": "world_effective" }
          }
        }
      ]
    },
    "EntityTypeId": {
      "enum": [
        "card_instance",
        "card_resolution",
        "commodity",
        "facility",
        "facility_slot",
        "military",
        "monster",
        "organization_slot",
        "player",
        "region",
        "route"
      ]
    },
    "EntityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type_id", "entity_id", "revision"],
      "properties": {
        "entity_type_id": { "$ref": "#/$defs/EntityTypeId" },
        "entity_id": { "$ref": "#/$defs/StableId" },
        "revision": { "$ref": "#/$defs/NonNegativeSafeInteger" }
      }
    },
    "CardTargetSpec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_binding_id", "target_id", "selection_mode_id", "minimum_count", "maximum_count", "allowed_entity_type_ids", "revalidation_policy_id"],
          "properties": {
            "target_binding_id": { "$ref": "#/$defs/StableId" },
            "target_id": { "const": "none" },
            "selection_mode_id": { "const": "none" },
            "minimum_count": { "const": 0 },
            "maximum_count": { "const": 0 },
            "allowed_entity_type_ids": { "const": [] },
            "revalidation_policy_id": { "const": "none" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_binding_id", "target_id", "selection_mode_id", "minimum_count", "maximum_count", "allowed_entity_type_ids", "revalidation_policy_id"],
          "properties": {
            "target_binding_id": { "$ref": "#/$defs/StableId" },
            "target_id": { "const": "same_industry_factory_or_market" },
            "selection_mode_id": { "const": "actor_choice" },
            "minimum_count": { "const": 1 },
            "maximum_count": { "const": 1 },
            "allowed_entity_type_ids": { "const": ["facility"] },
            "revalidation_policy_id": { "const": "commit_and_resolution" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_binding_id", "target_id", "selection_mode_id", "minimum_count", "maximum_count", "allowed_entity_type_ids", "revalidation_policy_id"],
          "properties": {
            "target_binding_id": { "$ref": "#/$defs/StableId" },
            "target_id": { "const": "region_unique_facility_slot" },
            "selection_mode_id": { "const": "actor_choice" },
            "minimum_count": { "const": 1 },
            "maximum_count": { "const": 1 },
            "allowed_entity_type_ids": { "const": ["facility_slot"] },
            "revalidation_policy_id": { "const": "commit_and_resolution" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_binding_id", "target_id", "selection_mode_id", "minimum_count", "maximum_count", "allowed_entity_type_ids", "revalidation_policy_id"],
          "properties": {
            "target_binding_id": { "$ref": "#/$defs/StableId" },
            "target_id": { "const": "global_matching_goods" },
            "selection_mode_id": { "const": "automatic_snapshot" },
            "minimum_count": { "const": 0 },
            "maximum_count": { "const": 0 },
            "allowed_entity_type_ids": { "const": [] },
            "revalidation_policy_id": { "const": "resolution_snapshot" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_binding_id", "target_id", "selection_mode_id", "minimum_count", "maximum_count", "allowed_entity_type_ids", "revalidation_policy_id"],
          "properties": {
            "target_binding_id": { "$ref": "#/$defs/StableId" },
            "target_id": { "const": "global_matching_factories" },
            "selection_mode_id": { "const": "automatic_snapshot" },
            "minimum_count": { "const": 0 },
            "maximum_count": { "const": 0 },
            "allowed_entity_type_ids": { "const": [] },
            "revalidation_policy_id": { "const": "resolution_snapshot" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_binding_id", "target_id", "selection_mode_id", "minimum_count", "maximum_count", "allowed_entity_type_ids", "revalidation_policy_id"],
          "properties": {
            "target_binding_id": { "$ref": "#/$defs/StableId" },
            "target_id": { "const": "region_or_existing_same_family_monster" },
            "selection_mode_id": { "const": "actor_choice" },
            "minimum_count": { "const": 1 },
            "maximum_count": { "const": 1 },
