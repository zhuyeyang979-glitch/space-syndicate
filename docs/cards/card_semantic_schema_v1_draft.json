{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.space-syndicate.invalid/cards/card-semantic-v1-draft.schema.json",
  "title": "Space Syndicate Card Semantic Contract v1 Draft",
  "description": "Wave-1 closed pure-data interface. This schema recognizes definitions and boundary records; production readiness is separately gated by x-op-family-registry.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/CardSemanticSpec" },
    { "$ref": "#/$defs/CardInstanceState" },
    { "$ref": "#/$defs/AiActionCandidate" },
    { "$ref": "#/$defs/AiProjectedOutcome" },
    { "$ref": "#/$defs/PlayerFaceDTOBoundaryRef" }
  ],
  "x-contract-version": "1.0.0-draft.1",
  "x-validation-policy": {
    "object_keys": "exact",
    "unknown_schema_version": "reject_before_use",
    "unknown_op_id": "reject_before_candidate_or_effect",
    "unknown_target_id": "reject_before_candidate_or_effect",
    "unknown_timing_id": "reject_before_candidate_or_effect",
    "unknown_authority_status": "reject_before_candidate_or_effect",
    "numbers": "json_safe_integers_only",
    "optional_values": "omit_key_never_null",
    "runtime_values": "json_primitives_arrays_and_objects_only"
  },
  "x-canonicalization": {
    "algorithm_id": "rfc8785_jcs_utf8_sha256_v1",
    "digest_format": "sha256:<64_lowercase_hex>",
    "dictionary_order": "rfc8785_utf16_code_unit_order",
    "semantic_array_order": "preserve",
    "set_array_order": "sort_ascii_ascending_and_reject_duplicates",
    "fingerprint_fields": {
      "CardSemanticSpec": "semantic_fingerprint",
      "CardInstanceState": "state_fingerprint",
      "AiActionCandidate": "candidate_fingerprint",
      "AiProjectedOutcome": "projection_fingerprint"
    },
    "self_field_rule": "remove_only_the_named_fingerprint_field_before_canonicalization"
  },
  "x-boundary-layers": [
    {
      "layer_id": "static_definition",
      "type_id": "CardSemanticSpec",
      "persistence_id": "catalog_owned_not_save_embedded"
    },
    {
      "layer_id": "instance_state",
      "type_id": "CardInstanceState",
      "persistence_id": "instance_owner_section"
    },
    {
      "layer_id": "legal_action",
      "type_id": "AiActionCandidate",
      "persistence_id": "ephemeral_never_saved"
    },
    {
      "layer_id": "projected_outcome",
      "type_id": "AiProjectedOutcome",
      "persistence_id": "ephemeral_never_saved"
    },
    {
      "layer_id": "presentation",
      "type_id": "PlayerFaceDTOBoundaryRef",
      "persistence_id": "presentation_cache_never_authoritative"
    }
  ],
  "x-op-family-registry": [
