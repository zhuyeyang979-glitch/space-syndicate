  "rules": [
    {
      "rule_id": "v075.monster.control_capacity",
      "domain": "monster_source",
      "statement": "A normal player may control one active monster plus a typed character semantic modifier; capacity loss never destroys an existing monster but blocks further deployment until the count is legal.",
      "value": {
        "base_active_monster_capacity_per_player": 1,
        "modifier_port": "CharacterMonsterControlCapacityPortV1",
        "hardcoded_character_name_exception_count": 0,
        "ui_capacity_writer_count": 0,
        "forced_kill_on_capacity_loss_count": 0
      }
    },
    {
      "rule_id": "v075.monster.card_modes",
      "domain": "monster_card_resolution",
      "statement": "Every monster card locks exactly one explicit mode and exact source or region target before public batch lock; resolution cannot auto-convert mode or retarget.",
      "value": {
        "allowed_modes": ["DEPLOY_NEW", "REFRESH_EXISTING", "UPGRADE_EXISTING", "REPLACE_EXISTING"],
        "mode_prebound": true,
        "mode_auto_conversion_count": 0,
        "target_reselection_count": 0,
        "refresh_max_hp_basis_points_by_card_rank": {"1": 2500, "2": 5000, "3": 7500, "4": 10000},
        "upgrade_heals_to_new_max_hp": true,
        "upgrade_resets_existing_cooldowns": false,
        "replacement_withdrawn_is_kill": false,
        "replacement_kill_reward_count": 0,
        "card_destination_after_resolution": "personal_discard"
      }
    },
    {
      "rule_id": "v075.monster.preferred_industry_color",
      "domain": "monster_catalog",
      "statement": "Every active monster family explicitly authors exactly one preferred industry color; runtime inference from display name, model color, or legacy resource_focus is forbidden.",
      "value": {
        "allowed_industry_colors": ["life", "energy", "industry", "technology", "commerce", "shipping"],
        "active_family_count": 6,
        "required_color_coverage": 6,
        "runtime_inference_count": 0,
        "usage": "autonomous_facility_targeting_only",
        "normal_card_primary_color_source": "existing_unified_track_color_supply",
        "preferred_color_affects_card_primary_color": false,
        "preferred_color_affects_card_asset_cost": false,
        "legacy_resource_focus_is_migration_reference_only": true
      }
    },
    {
      "rule_id": "v075.monster.autonomous_targeting",
      "domain": "monster_autonomy",
      "statement": "At maintenance, each active monster deterministically selects the nearest reachable enemy public facility whose industry_id matches its preferred color using the frozen dynamic-region adjacency snapshot.",
      "value": {
        "candidate_facility_types": ["factory", "market", "warehouse"],
        "required_candidate_fields": ["facility_id", "facility_generation", "facility_type", "industry_id", "region_id", "owner_player_id", "damage_state", "destroyed"],
        "owner_facilities_are_targets": false,
        "private_asset_reader_count": 0,
        "private_warehouse_stock_reader_count": 0,
        "distance_metric": "dynamic_region_adjacency_shortest_path_hops",
        "tie_break_order": ["facility_type_preference", "authoring_target_priority", "facility_damage_state", "facility_id_lexicographic"],
        "no_match_behavior": "expand_detection_range_by_one_hop_next_batch",
        "full_map_no_match_behavior": "hungry_nearest_any_enemy_public_facility",
        "matching_color_reappearance_behavior": "restore_color_priority_and_base_detection_range",
        "camera_or_pixel_input_count": 0
      }
    },
    {
      "rule_id": "v075.monster.autonomous_movement",
      "domain": "monster_autonomy",
      "statement": "All monster targets and paths are planned simultaneously from one frozen public snapshot; authority changes region identity only by committed movement receipts while presentation animates the frozen plan.",
      "value": {
        "batch_order": [
          "complete_public_actions",
          "drain_accepted_private_skills_at_safe_boundary",
          "freeze_autonomy_input",
          "compute_all_targets_and_paths",
          "freeze_all_movement_plans",
          "present_in_stable_internal_order",
          "commit_aggregated_trample",
          "commit_arrival_basic_attacks",
          "maintenance",
          "victory_revalidation"
        ],
        "target_snapshot_count_per_maintenance": 1,
        "target_order_bias_count": 0,
        "authoritative_position_updated_per_animation_frame": false,
        "land_ocean_passability_modifier_count": 0
      }
    },
    {
      "rule_id": "v075.monster.ground_trample",
      "domain": "monster_trample",
      "statement": "Only ground_trample movement damages enemy facilities along traversed regions; flying and teleport movement do not trample, and forced movement defaults to no trample.",
      "value": {
        "movement_damage_profiles": ["ground_trample", "flying_no_trample", "teleport_no_trample"],
        "trample_target_facility_types": ["factory", "market", "warehouse"],
        "trample_unit_damage_count": 0,
        "trample_region_hp_mutation_count": 0,
        "flying_trample_damage_count": 0,
        "teleport_trample_damage_count": 0,
        "default_forced_movement_trample": false,
        "positive_distance_minimum_step_count": 1,
        "per_region_cap_required": true,
        "target_order": ["preferred_color_enemy_facilities", "other_enemy_facilities", "facility_id_lexicographic"]
      }
    },
    {
      "rule_id": "v075.monster.fixed_point_geodesic_distance",
      "domain": "monster_trample",
      "statement": "Trample identity is derived only from deterministic fixed-point spherical arc distance aggregated once per traversed region; visual geometry complexity cannot change damage.",
      "value": {
        "distance_field": "distance_milli_arc",
        "distance_type": "nonnegative_integer",
        "path_field": "ordered_region_path",
        "segment_fields": ["region_id", "distance_milli_arc"],
        "same_region_segments_aggregated_before_damage": true,
        "float_accumulator_is_final_damage_identity": false,
        "polygon_vertex_count_input": false,
        "microcell_count_input": false,
        "screen_pixel_distance_input": false,
        "camera_projection_input": false,
        "loop_count_required": 0,
        "formula": "min(max(1,floor(distance_milli_arc/trample_distance_step_milli_arc))*trample_damage_per_step_by_rank[rank],trample_damage_cap_per_region_by_rank[rank])",
        "numeric_parameter_authority": "docs/rules/v075_combat_balance_defaults.json"
      }
    },
    {
      "rule_id": "v075.monster.rank_skill_unlock",
      "domain": "monster_private_skill",
      "statement": "Monster rank unlocks one through four owner-private active skills; the fourth rank-four skill is the sole ultimate and automatic abilities never count as skill cards.",
      "value": {
        "active_skill_count_by_rank": {"1": 1, "2": 2, "3": 3, "4": 4},
        "rank_four_ultimate_count": 1,
        "ultimate_required_skill_ordinal": 4,
        "automatic_abilities_excluded": ["preferred_color", "autonomous_targeting", "autonomous_movement", "ground_trample", "arrival_basic_attack", "passive_traits"],
        "active_skill_definition_count": 24
      }
    },
    {
      "rule_id": "v075.monster.private_instant_skill_zone",
      "domain": "monster_private_skill",
      "statement": "Monster active skills live only in the owner's private source-bound dock and execute through a private serial authority; they never enter public card queues, hand, deck, discard, commodity inventory, or merge flows.",
      "value": {
        "execution_mode": "private_instant_serial",
        "public_batch_queue_member": false,
        "normal_five_action_rotation_member": false,
        "public_arrangement_member": false,
        "normal_hand_member": false,
        "normal_deck_member": false,
        "normal_discard_member": false,
        "commodity_inventory_member": false,
        "mergeable": false,
        "private_sequence_owner": "V075CombatRuntimeOwner",
        "max_uses_per_source_per_batch": 1
      }
    },
    {
      "rule_id": "v075.monster.instant_safe_boundary",
      "domain": "monster_private_skill",
      "statement": "A legal private skill request resolves immediately when no atomic transaction is active, otherwise at the first safe receipt boundary without interrupting, rolling back, or peeking into future public actions.",
      "value": {
        "allowed_request_phases": ["batch_active", "public_resolution_between_receipts", "maintenance_before_autonomy"],
        "forbidden_request_phases": ["victory_resolved", "final_settlement", "terminal"],
        "atomic_transaction_reentry_allowed": false,
        "interrupt_current_atomic_action": false,
        "next_safe_boundary_required": true,
        "interactive_counters_enabled": false,
        "ordering": ["authority_receive_sequence", "stable_player_id", "request_id"],
        "internal_order_public": false,
        "future_public_queue_reader_count": 0
      }
    },
    {
      "rule_id": "v075.monster.cooldown_and_reuse",
      "domain": "monster_private_skill",
      "statement": "A successful skill consumes only available unreserved assets and enters batch cooldown; accepted requests that fizzle refund assets, start no cooldown, and consume the source's one-use batch allowance.",
      "value": {
        "skill_states": ["LOCKED_BY_RANK", "READY", "PENDING_SAFE_BOUNDARY", "RESOLVING", "COOLDOWN", "DISABLED", "REVOKED"],
        "asset_source": "available_unreserved_assets",
        "public_action_reserved_assets_consumable": false,
        "reservation_lifetime": "single_atomic_private_skill_request",
        "accepted_fizzle_asset_refund": "full",
        "accepted_fizzle_cooldown_started": false,
        "accepted_fizzle_consumes_batch_use": true,
        "preacceptance_rejection_consumes_assets": false,
        "preacceptance_rejection_consumes_batch_use": false,
        "upgrade_resets_existing_cooldown": false,
        "newly_unlocked_skill_initial_state": "READY",
