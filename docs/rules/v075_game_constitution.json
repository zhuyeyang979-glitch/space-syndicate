      "value": {
        "public_fields": ["source_instance_id", "source_generation", "public_owner_identity", "monster_family_id", "display_name", "rank", "hp", "max_hp", "armor", "status", "preferred_industry_color", "region_id", "tracked_region_id", "tracked_facility_id", "expected_region_path", "unlocked_skill_count", "batch_active_skill_used"],
        "owner_private_fields": ["skill_definition_id", "private_skill_name", "asset_cost_by_color", "target_contract", "range_contract", "cooldown_batches", "cooldown_remaining_batches", "ultimate", "pending_private_target"],
