  "constitutional_rules": [
    {
      "rule_id": "v07.track.single_unified_track",
      "domain": "unified_card_track",
      "value": true,
      "statement": "One globally ordered cyclic sushi track carries both normal cards and commodity cards."
    },
    {
      "rule_id": "v07.track.allowed_card_kinds",
      "domain": "unified_card_track",
      "value": ["normal_card", "commodity_card"],
      "statement": "Only the closed normal_card and commodity_card kinds are mixed on the unified track."
    },
    {
      "rule_id": "v07.track.legacy_sources_retired",
      "domain": "unified_card_track",
      "value": {
        "separate_normal_card_track": false,
        "separate_commodity_track": false,
        "region_bound_normal_card_pool": false
      },
      "statement": "Separate tracks and region-bound ordinary-card pools are not V0.7 authorities."
    },
    {
      "rule_id": "v07.track.primary_color_identity",
      "domain": "unified_card_track",
      "value": ["life", "energy", "industry", "technology", "commerce", "shipping"],
      "statement": "Every track card has one primary identity from the closed six-color set."
    },
    {
      "rule_id": "v07.track.local_segment_visibility",
      "domain": "unified_card_track",
      "value": {
        "visibility": "viewer_own_segment_only",
        "claim_authority": "one_exclusive_segment_per_item",
        "overlapping_claim_windows": false,
        "viewer_side_tie_breaker": false
      },
      "statement": "A viewer sees and may claim concrete cards only in that viewer's exclusive local segment."
    },
    {
      "rule_id": "v07.track.motion_order",
      "domain": "unified_card_track",
      "value": "enter_at_hidden_lead_then_follow_frozen_hidden_lead_order",
      "statement": "Cards enter nearest the hidden lead and pass local segments in the frozen hidden lead order."
    },
    {
      "rule_id": "v07.track.shared_generation_contract",
      "domain": "unified_card_track",
      "value": {
        "shared_player_order": true,
        "shared_movement_cadence": true,
        "shared_color_distribution": true,
        "card_kind_ratio_independent_of_player_color_stances": true,
        "unclaimed_lifecycle": "traverse_all_segments_then_exit",
        "refill_owner": "authoritative_unified_track_supply"
      },
      "statement": "Both card kinds share order, movement, and color distribution while the kind ratio remains independently balanced."
    },
    {
      "rule_id": "v07.track.distinct_acquisition_owners",
      "domain": "unified_card_track",
      "value": {
        "normal_card_destination": "personal_discard",
        "commodity_card_destination": "commodity_inventory",
        "commodity_claim_cash_cost": 0,
        "commodity_claim_asset_cost": 0,
        "commodity_claim_phase": "world_and_track_acquisition_active",
        "full_commodity_inventory_result": "reject_without_discard_or_auto_merge_and_item_continues"
      },
      "statement": "Sharing a track does not merge normal-card and commodity inventory ownership."
    },
    {
      "rule_id": "v07.color_cycle.uniform_reset",
      "domain": "market_color_cycle",
      "value": {
        "color_order": ["life", "energy", "industry", "technology", "commerce", "shipping"],
        "equal_weight_per_color": 1,
        "total_weight": 6,
        "previous_cycle_distribution_inherited": false,
        "cycle_modifiers_compound": false
      },
      "statement": "Every color cycle is recalculated from a uniform six-color baseline without inheritance or compounding."
    },
    {
      "rule_id": "v07.color_cycle.gdp_independence",
      "domain": "market_color_cycle",
      "value": {
        "gdp_affects_track_color_distribution": false,
