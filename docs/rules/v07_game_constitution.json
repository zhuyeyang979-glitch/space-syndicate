        "mergeable": false,
        "lifecycle_bound_to_source": true
      },
      "statement": "Monster and military sources may grant actions that remain bound to their source and outside both card inventories."
    },
    {
      "rule_id": "v07.bound_action.batch_capacity",
      "domain": "bound_actions",
      "value": {
        "active_bound_action_counts_as_batch_action": true,
        "passive_bound_action_counts_as_batch_action": false
      },
      "statement": "An active bound action consumes one batch action slot while a passive ability does not."
    },
    {
      "rule_id": "v07.batch.one_shot_window",
      "domain": "card_batch_submission",
      "value": {
        "duration_seconds": 30,
        "one_shot": true
      },
      "statement": "Each submission window lasts thirty seconds and locks one batch."
    },
    {
      "rule_id": "v07.batch.reopen_gate",
      "domain": "card_batch_submission",
      "value": ["batch_resolved", "assets_refreshed", "hand_maintenance_complete", "optional_merge_flow_complete"],
      "statement": "A new window opens only after resolution, asset refresh, and hand maintenance are complete."
    },
    {
      "rule_id": "v07.batch.shared_active_capacity",
      "domain": "card_batch_submission",
      "value": {
        "minimum": 0,
        "maximum": 5,
        "shared_kinds": ["normal_card", "commodity_card", "monster_action", "military_action"],
        "capacity_modifiers_allowed": false
      },
      "statement": "All active action kinds share a maximum of five actions per player per batch."
    },
    {
      "rule_id": "v07.batch.prebound_targets_and_local_order",
      "domain": "card_batch_submission",
      "value": {
        "complete_targets_selected_before_lock": true,
        "player_local_order_selected_before_lock": true,
        "complete_six_color_cost_visible_before_lock": true
      },
      "statement": "Every action has complete prebound targets, local order, and visible cost before queue lock."
    },
    {
      "rule_id": "v07.batch.lock_immutability",
      "domain": "card_batch_submission",
      "value": {
        "card_mutable_after_lock": false,
        "target_mutable_after_lock": false,
        "local_order_mutable_after_lock": false
      },
      "statement": "Cards, targets, and local order are immutable after lock."
    },
    {
      "rule_id": "v07.reservation.full_queue",
      "domain": "asset_reservations",
      "value": {
        "full_queue_affordability_required": true,
        "lock_is_atomic": true,
        "per_action_reservation_required": true
      },
      "statement": "A local queue locks only if all of its actions can reserve their full six-color costs atomically."
    },
    {
      "rule_id": "v07.reservation.per_action_outcome",
      "domain": "asset_reservations",
      "value": {
        "successful_resolution": "consume_reservation",
        "rule_allowed_fizzle_refund": "release_reservation"
      },
      "statement": "Each action consumes or releases only its own reservation according to its authoritative result."
    },
    {
      "rule_id": "v07.reservation.no_future_refresh",
      "domain": "asset_reservations",
      "value": true,
      "statement": "Assets expected from the next refresh cannot fund the current batch."
    },
    {
      "rule_id": "v07.assets.player_term_and_colors",
      "domain": "six_color_assets",
      "value": {
        "player_term": "six_color_assets",
        "retired_player_terms": ["mana", "mana_points", "\u6cd5\u529b", "\u6cd5\u529b\u503c", "\u739b\u5a1c"],
        "colors": ["life", "energy", "industry", "technology", "commerce", "shipping"],
        "localized_player_asset_names_zh": ["\u751f\u547d\u8d44\u4ea7", "\u80fd\u6e90\u8d44\u4ea7", "\u5de5\u4e1a\u8d44\u4ea7", "\u79d1\u6280\u8d44\u4ea7", "\u5546\u8d38\u8d44\u4ea7", "\u822a\u8fd0\u8d44\u4ea7"]
      },
      "statement": "The player-facing resource is six-color assets, not mana."
    },
    {
      "rule_id": "v07.assets.per_color_cap",
      "domain": "six_color_assets",
      "value": 6,
      "statement": "Each color has an independent asset cap of six."
    },
    {
      "rule_id": "v07.assets.no_continuous_recovery",
      "domain": "six_color_assets",
      "value": {
        "continuous_recovery": false,
        "recovery_mode": "cycle_end_top_up"
      },
      "statement": "Assets top up at the cycle boundary rather than recovering continuously."
    },
    {
      "rule_id": "v07.assets.frozen_gdp_snapshot",
      "domain": "asset_cycle_snapshot",
      "value": {
        "snapshot_timing": "card_window_lock",
        "source": "player_own_per_color_completed_commodity_gdp",
        "reread_after_resolution": false
      },
      "statement": "Queue lock freezes the player's own completed per-color GDP snapshot used for the later refresh."
    },
    {
      "rule_id": "v07.assets.post_batch_top_up",
      "domain": "asset_cycle_snapshot",
      "value": "after_batch_resolution_consumption_and_refunds",
      "statement": "The frozen snapshot is applied once after the entire batch resolves and reservations settle."
    },
    {
      "rule_id": "v07.assets.carry_and_overflow",
      "domain": "six_color_assets",
      "value": {
        "unused_assets_carry_over": true,
        "overflow_above_cap_discarded": true,
        "fixed_point_remainder_required": true
      },
      "statement": "Unused assets persist, cap overflow is discarded, and fixed-point remainder preserves small accrual."
    },
    {
      "rule_id": "v07.assets.owner_gdp_scope",
      "domain": "six_color_assets",
      "value": {
        "own_gdp_refreshes_own_assets": true,
        "opponent_gdp_refreshes_assets": false,
        "gdp_affects_track": false
      },
      "statement": "Only the player's own same-color GDP refreshes that player's assets, and GDP never drives track supply."
    },
    {
      "rule_id": "v07.action_cost.authored_six_color",
      "domain": "action_cost",
      "value": {
        "data_declared": true,
        "supports_primary_color": true,
        "supports_secondary_color": true,
        "supports_limited_any_asset": true
      },
      "statement": "Every active action declares a complete six-color asset cost in authoritative data."
    },
    {
      "rule_id": "v07.action_cost.any_is_not_pool",
      "domain": "action_cost",
      "value": true,
      "statement": "Any-asset cost is a payment constraint over six colors, not a seventh asset pool."
    },
    {
      "rule_id": "v07.counter.retired",
      "domain": "anonymous_resolution",
      "value": {
        "interactive_counters": false,
        "counter_window": false,
        "counter_stack": false,
        "counter_the_counter": false
      },
      "statement": "V0.7 has no interactive counter window or counter stack."
    },
    {
      "rule_id": "v07.resolution.no_new_input",
      "domain": "anonymous_resolution",
      "value": {
        "accepts_new_gameplay_input": false,
        "accepts_new_target_selection": false,
        "accepts_normal_card_play": false
      },
      "statement": "Resolution accepts no new gameplay input or target selection."
    },
    {
      "rule_id": "v07.defense.precommitted_or_passive",
