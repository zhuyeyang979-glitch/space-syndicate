      "statement": "Final settlement is gated by completed batch maintenance and a complete lead macro round."
    },
    {
      "rule_id": "v07.victory.revalidate_and_exact_once",
      "domain": "macro_round_victory_gate",
      "value": {
        "revalidate_at_macro_round_boundary": true,
        "failed_revalidation": "clear_pending_and_continue",
        "successful_revalidation": "final_settlement_exact_once"
      },
      "statement": "The boundary revalidates victory; failure resumes play and success enters exact-once final settlement."
    },
