      "rule_id": "v07.runtime.single_authority_cutover",
      "domain": "cutover",
      "value": {
        "runtime_cutover_now": false,
        "v06_and_v07_dual_write": false,
        "atomic_owner_cutover_required": true
      },
      "statement": "This frozen target does not change runtime and future production ownership must cut over atomically without dual writers."
