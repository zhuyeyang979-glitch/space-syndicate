      "value": {
        "precommit_during_active_cycle": true,
        "simultaneous_reveal_at_boundary": true,
        "empty_voting_downtime": false
      },
      "statement": "Players prepare the next stance during active play and all legal stances reveal at the boundary without a waiting phase."
    },
    {
      "rule_id": "v07.color_cycle.invalid_stance_neutral",
