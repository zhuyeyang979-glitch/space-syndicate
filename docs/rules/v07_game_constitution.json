      "domain": "macro_round_victory_gate",
      "value": {
        "inherited_scope": "all_unmodified_v06_end_conditions_and_victory_audit_comparison",
        "mid_macro_round_result": "pending_without_immediate_final_settlement"
      },
      "statement": "V0.7 initially inherits every unmodified V0.6 end condition and comparison, but all triggers enter the same pending macro-round gate."
