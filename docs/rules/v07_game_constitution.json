      "rule_id": "v07.solar.efficiency",
      "domain": "solar_facility_efficiency",
      "value": {
        "sunlit_multiplier": 2.0,
        "dark_multiplier": 1.0
      },
      "statement": "Sunlit facilities operate at 200 percent and dark facilities at 100 percent."
    },
    {
      "rule_id": "v07.solar.work_rate_channels",
      "domain": "solar_facility_efficiency",
      "value": ["factory_production_rate", "market_demand_or_consumption_rate", "warehouse_ingress_throughput", "warehouse_egress_throughput"],
      "statement": "Only explicitly declared work-rate channels receive the solar multiplier."
