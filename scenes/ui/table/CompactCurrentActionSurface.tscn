[gd_scene load_steps=4 format=3]

[ext_resource type="Theme" path="res://themes/GameTheme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/ui/table/compact_current_action_surface.gd" id="2_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/ActionDock.tscn" id="3_action_dock"]

[sub_resource type="StyleBoxFlat" id="StyleCurrentAction"]
bg_color = Color(0.018, 0.04, 0.085, 0.96)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.22, 0.74, 0.97, 0.78)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="CompactCurrentActionSurface" type="PanelContainer"]
custom_minimum_size = Vector2(420, 84)
mouse_filter = 1
theme = ExtResource("1_theme")
theme_override_styles/panel = SubResource("StyleCurrentAction")
script = ExtResource("2_script")

[node name="CurrentActionMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 4

[node name="CurrentActionRow" type="HBoxContainer" parent="CurrentActionMargin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CurrentActionCopy" type="VBoxContainer" parent="CurrentActionMargin/CurrentActionRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 3

[node name="CurrentActionHeaderLine" type="HBoxContainer" parent="CurrentActionMargin/CurrentActionRow/CurrentActionCopy"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="CurrentActionTitle" type="Label" parent="CurrentActionMargin/CurrentActionRow/CurrentActionCopy/CurrentActionHeaderLine"]
unique_name_in_owner = true
custom_minimum_size = Vector2(78, 0)
layout_mode = 2
text = "当前行动"
text_overrun_behavior = 3
clip_text = true

[node name="CurrentActionSummary" type="Label" parent="CurrentActionMargin/CurrentActionRow/CurrentActionCopy/CurrentActionHeaderLine"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.82, 0.88, 0.96, 1)
text = "等待 viewer-authorized 行动上下文。"
text_overrun_behavior = 3
clip_text = true

[node name="CurrentActionReason" type="Label" parent="CurrentActionMargin/CurrentActionRow/CurrentActionCopy/CurrentActionHeaderLine"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.98, 0.75, 0.42, 1)
text_overrun_behavior = 3
clip_text = true

[node name="CurrentActionFactLine" type="HBoxContainer" parent="CurrentActionMargin/CurrentActionRow/CurrentActionCopy"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="CurrentActionCosts" type="Label" parent="CurrentActionMargin/CurrentActionRow/CurrentActionCopy/CurrentActionFactLine"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 9
text = "成本｜--"
text_overrun_behavior = 3
clip_text = true

[node name="CurrentActionRequirements" type="Label" parent="CurrentActionMargin/CurrentActionRow/CurrentActionCopy/CurrentActionFactLine"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 9
text = "要求｜--"
